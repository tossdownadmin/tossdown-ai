BEDROCK_MODEL_ID=copy-the-working-model-or-inference-profile-id-from-aws
AWS_REGION=eu-north-1
# Optional: when set, this takes precedence over AWS_ROLE_ARN/OIDC credentials.
AWS_BEARER_TOKEN_BEDROCK=
AWS_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/ROLE_NAME
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
# Optional Vercel KV-compatible aliases; UPSTASH_* takes precedence when both are set.
KV_REST_API_URL=
KV_REST_API_TOKEN=
MOCK_MODE=false
MCP_ENABLED=false
MCP_REQUIRE_AUTH=true
MCP_GOOGLE_ADS_URL=
MCP_GOOGLE_ADS_TOKEN=
MCP_GOOGLE_ADS_READ_TOOLS=
MCP_META_ADS_URL=
MCP_META_ADS_READ_TOOLS=
META_MCP_CLIENT_ID=
MCP_TOKEN_ENCRYPTION_KEY=
BEDROCK_MODEL_IDS=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
